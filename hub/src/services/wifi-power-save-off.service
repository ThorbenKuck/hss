[Unit]
Description=Disable Wi-Fi power saving for low-latency HSS audio
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'if command -v iw >/dev/null 2>&1 && iw dev wlan0 info >/dev/null 2>&1; then iw dev wlan0 set power_save off; fi'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target